#!/bin/sh
# ============================================================================
#  Gate de calidad. CORTO A PROPOSITO.
#
#  En el Tablero Contable este mismo hook corre tsc mas la suite entera y tarda de 90 a 180
#  segundos: tanto, que su CLAUDE.md tiene que avisar de pasarle un timeout de 420000 ms a
#  la herramienta que llama a git commit. Un gate que duele se termina salteando con
#  --no-verify, y ahi no protege de nada.
#
#  Aca corre: secretos, tipos, lint, y SOLO los tests afectados por lo que se toco.
#  La suite completa la corre GitHub Actions en cada push.
# ============================================================================
export PATH="$HOME/tools/node-v22.17.0-win-x64:$PATH"

node scripts/sin-secretos.mjs || exit 1
node scripts/migraciones-sanas.mjs || exit 1
node scripts/colores-sanos.mjs || exit 1

# EL CONTRASTE, desde el 28/08/2026. No necesita red ni token: lee src/index.css y calcula. Mira
# dos cosas distintas, y las dos son invisibles a ojo:
#   - que los ocho pares que existen en pantalla lleguen a AA, en claro Y en oscuro;
#   - que los DOS bloques de modo oscuro digan lo mismo. Ese defecto aparecio el mismo dia que se
#     escribio el guardian: un reemplazo cambio el bloque del interruptor y no el del sistema
#     operativo, y la app quedo con dos temas oscuros distintos segun como se hubiera llegado.
node scripts/contraste-sano.mjs || exit 1

# LOS DOS QUE CONSULTAN LA BASE. Sin SUPABASE_ACCESS_TOKEN se saltean y salen con 0, asi que en
# un repo recien clonado no rompen el primer commit.
#
#   `indices`  entro el 27/08/2026, cuando la migracion del saldo inicial lo puso en verde. Antes
#              estaba en rojo por un defecto real, y meter un guardian rojo al pre-commit bloquea
#              todos los commits, incluido el que lo arregla.
#   `estados`  compara la lista de estados del front contra el check de la base. Existe porque el
#              27/08/2026 la cadena cambio, las 198 pruebas quedaron en verde, y el front quedo
#              mandando estados que la base ya rechazaba. Lo agarro un grep a mano.
node scripts/indices-sanos.mjs || exit 1
node scripts/estados-sanos.mjs || exit 1

# FALTA UNO: `espacios` esta en rojo con 9 hallazgos que son decisiones visuales del rediseno, no
# arreglos mecanicos. Entra cuando el front se rehaga. Mientras tanto: `npm run espacios`.

# Si todavia no hay dependencias instaladas, el hook no puede correr el resto. No se falla
# por eso: en un repo recien clonado el primer commit no deberia exigir un npm install.
[ -d node_modules ] || { echo "pre-commit: sin node_modules, se saltean tipos, lint y tests"; exit 0; }

npx tsc --noEmit || exit 1
npx oxlint || exit 1

# EL FORMATO, desde el 27/08/2026. Entro cuando dejo de ser ruido: antes marcaba 93 de 128
# archivos y casi todo era conversion de finales de linea, no formato. Con el .gitattributes
# puesto y la prosa excluida, marca 0 — y un guardian que empieza en verde es el unico que se
# puede exigir sin que alguien lo termine salteando con --no-verify.
npx oxfmt --check . || exit 1

CAMBIOS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)
if [ -n "$CAMBIOS" ]; then
  npx vitest related --run $CAMBIOS || exit 1
fi
