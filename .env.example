# Copiar a .env.local y completar. .env.local esta en .gitignore y NUNCA se commitea.
#
# La clave publicable de Supabase es PUBLICA por diseno: viaja en el navegador de todos. Lo que
# protege los datos es la RLS, no esta clave. Aun asi entra por variable de entorno, porque es
# lo que permite que la vista previa apunte a una base y produccion a otra.
VITE_SUPABASE_URL=https://drsooohkwwpnijonxwwt.supabase.co
VITE_SUPABASE_ANON_KEY=

# El DSN de Sentry tambien viaja en el navegador por diseno.
VITE_SENTRY_DSN=

# SOLO PARA LA TERMINAL, no lo usa la app. Es de CUENTA: llega a todos los proyectos.
SUPABASE_ACCESS_TOKEN=
