# Copiar a .env.local y completar. .env.local esta en .gitignore y NUNCA se commitea.
#
# La clave publicable de Supabase es PUBLICA por diseno: viaja en el navegador de todos. Lo que
# protege los datos es la RLS, no esta clave. Aun asi entra por variable de entorno, porque es
# lo que permite que la vista previa apunte a una base y produccion a otra.
VITE_SUPABASE_URL=https://drsooohkwwpnijonxwwt.supabase.co
VITE_SUPABASE_ANON_KEY=

# El DSN de Sentry tambien viaja en el navegador por diseno.
VITE_SENTRY_DSN=

# SOLO PARA LA TERMINAL, no lo usa la app. Es de CUENTA: llega a todos los proyectos.
SUPABASE_ACCESS_TOKEN=

# ============================================================================
#  CUENTAS PARA LAS PRUEBAS DE PERMISOS (`npm run test:rls`)
#
#  Son cuentas REALES de la base: el arnes se loguea con cada una contra la API de verdad,
#  porque lo que hay que garantizar no es que la policy sea correcta en abstracto, sino que
#  devuelve PostgREST.
#
#  NO HAY UNA CUENTA SIN ROL ASIGNADO. El registro publico esta apagado a proposito, asi que
#  una cuenta nueva la tiene que crear gerencia desde el panel. Mientras no exista, la prueba
#  del default seguro —"alguien recien dado de alta no ve nada"— se cubre con lo que si se
#  puede: que nadie se cambie el rol ni se active solo. Decirlo es parte del trabajo.
# ============================================================================
PRUEBA_PASSWORD=
PRUEBA_GERENCIA=
PRUEBA_CONTABLE=
PRUEBA_GESTORA=
PRUEBA_GESTORA_2=
