# Dependencias y build
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ============================================================
# SECRETOS. Va primero en importancia, no en orden alfabetico.
#
# POR QUE ESTA ASI DE EXPLICITO: en el Tablero Contable una contrasena quedo en el historial
# de git, su propio analisis de seguridad la marca con severidad ALTA, y sigue ahi. Sacar un
# secreto del historial es reescribir la historia del repositorio; no dejarlo entrar cuesta
# escribir estas lineas.
#
# El token de Supabase (sbp_...) y el de GitHub van SIEMPRE en .env.local, nunca en el codigo.
# La clave publicable de Supabase (sb_publishable_...) SI puede ir en el codigo: es publica por
# diseno, y lo que protege los datos es la RLS, no esa clave.
# ============================================================
.env
.env.*
!.env.example

# Supabase CLI
supabase/.temp/
supabase/.branches/

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ============================================================
# RESPALDOS BAJADOS DE LA APP.
#
# El boton de Administracion baja un JSON con TODO lo que hay en la base: nombres de clientes,
# dominios, importes y correos. El navegador lo deja en la carpeta de descargas, y si esa
# carpeta es esta, queda a un `git add -A` de entrar al repositorio para siempre.
#
# Ya paso una vez, el 20/08/2026: quedo suelto en la raiz. No llego a commitearse porque se
# miro el `git status` antes; esta linea es para no depender de eso.
# ============================================================
respaldo-gestoria-*.json

# Tests y reportes
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Fuente original del pedido: se conserva, pero el .docx es binario y no aporta al diff.
# El texto extraido si esta versionado, en docs/fuente/.
*.docx

# Lo que genera Playwright al correr. Las capturas de referencia SI se versionan; lo que
# produce una corrida, no.
test-results/
playwright-report/
e2e/**/*-snapshots/*-actual.png
